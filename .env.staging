# Staging Environment Configuration
# 这个文件包含staging环境的环境变量模板
# 实际的敏感值应该在GitHub Secrets中配置

# Supabase Configuration (Staging)
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_staging_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_staging_service_role_key_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-staging-domain.vercel.app
NEXT_PUBLIC_VERCEL_ENV=staging

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEBUG=true

# API Configuration
CRON_SECRET=your_staging_cron_secret_here

# CDN Configuration (Optional)
CDN_URL=

# Environment Identifier
NODE_ENV=production
VERCEL_ENV=staging
