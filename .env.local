# Supabase配置
# 请在Supabase项目创建后填入以下信息
# 1. 访问 https://app.supabase.com
# 2. 创建新项目，选择新加坡区域
# 3. 在 Settings > API 中获取以下信息
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase 服务密钥（仅服务端使用，不要暴露到客户端）
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudflare配置（可选，用于高级CDN配置）
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# 应用配置
NEXT_PUBLIC_APP_NAME=免费文件上传网站
NEXT_PUBLIC_MAX_FILE_SIZE=52428800
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/*,application/pdf,text/*,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# 监控配置
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_STORAGE_WARNING_THRESHOLD=0.9
NEXT_PUBLIC_BANDWIDTH_WARNING_THRESHOLD=0.8
