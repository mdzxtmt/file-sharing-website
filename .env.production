# Production Environment Configuration
# 这个文件包含production环境的环境变量模板
# 实际的敏感值应该在GitHub Secrets中配置

# Supabase Configuration (Production)
NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_VERCEL_ENV=production

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEBUG=false

# API Configuration
CRON_SECRET=your_production_cron_secret_here

# CDN Configuration
CDN_URL=https://cdn.your-domain.com

# Environment Identifier
NODE_ENV=production
VERCEL_ENV=production

# Security Configuration
NEXT_PUBLIC_ENABLE_CSP=true
NEXT_PUBLIC_ENABLE_SECURITY_HEADERS=true
